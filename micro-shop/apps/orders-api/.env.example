# Copy to .env (never committed). `pnpm dev` loads it.

# Neon Postgres, your own branch (not production). The Orders API owns the `orders` schema.
# Without it, orders are kept in memory (the demo orders still show).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# Optional:
# ORDERS_API_PORT=4002
# AUTH_SESSION_URL=http://localhost:4001/api/auth/session
# Shared with the Cart API, which calls POST /internal/orders. Required in
# production; development uses a fixed value when unset.
# INTERNAL_API_TOKEN=
