# Copy to .env (never committed) and fill in. `pnpm dev` loads it.

# Neon Postgres. Use your own branch for development, not production:
#   Neon console → project mciro-shop → Branches → your branch → Connect.
# Without it, the Cart API keeps carts in memory (lost on restart).
# Keep sslmode=verify-full (verify Neon's certificate); Neon adds channel_binding=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# Optional:
# CART_API_PORT=4005
# CATALOG_URL=http://localhost:3004/catalog.json
