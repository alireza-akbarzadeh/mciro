# Copy to .env (never committed). `pnpm dev` loads it.

# Neon Postgres, your own branch (not production). The Auth API owns the `auth` schema.
# Without it, users and sessions are kept in memory (the demo users still work).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require

# Optional:
# AUTH_API_PORT=4001
# SESSION_TTL_HOURS=8
