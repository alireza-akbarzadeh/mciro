# Copy to .env (never committed). Next.js loads it in dev and build; the
# db:* scripts load it too.

# Neon Postgres, your own branch (not production). The storefront owns the
# `catalog` schema. Without it, the storefront serves its seed catalog
# (lib/catalog-data.ts), so a fresh checkout still has a shop.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require
